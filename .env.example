
PORT=3000

# MySQL connection (the account you use in MySQL Workbench / command line)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=shop_db

# Any long random text. Used to sign login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# The admin account that "npm run setup" creates. Change the password!
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=admin12345
